# .gitignore — Grand Sirenis Locker App
# No commitear credenciales, dependencias ni respaldos.
# El esquema del proyecto (db/**/*.sql) SÍ debe versionarse.

# Credenciales y configuración local con secretos
# private/config.php NO contiene secretos (lee .env) y sí se versiona.
.env
.env.local
*.env
!.env.example

# Dependencias Node
node_modules/

# Respaldos de base de datos y storage (no ignorar el esquema del proyecto)
storage/
/respaldos/
backups/
**/backups/
hotel_lockers_*.sql
lockers_respaldo_*.json
*.bak
*.zip

# Playwright resultados y reportes
playwright-report/
test-results/
screenshots/
tests/results/

# Estado local de la aplicación (throttle de login)
runtime/

# IDE (conservar las tareas compartidas de VS Code)
.vscode/*
!.vscode/tasks.json
.idea/
*.code-workspace

# Sistema operativo
Thumbs.db
Desktop.ini
*~

# Logs
*.log
error_log
