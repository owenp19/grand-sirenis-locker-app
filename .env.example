# Variables de entorno — Grand Sirenis Locker App
# Copia este archivo a `.env` y ajusta los valores locales.
# NUNCA versiones `.env` (está en .gitignore). No incluyas credenciales reales aquí.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sirenis_locker_db
# Usuario de aplicación con privilegios mínimos (NO usar root)
DB_USER=owenpusey
DB_PASSWORD=cambia_esta_clave
TIME_ZONE=America/Bogota

# Cifrado de respaldos (clave separada de DB_PASSWORD; no versionar valores reales)
# BACKUP_ENC_PWD: contraseña para cifrar/descifrar respaldos (gestor de secretos)
BACKUP_ENC_PWD=cambia_esta_clave_de_cifrado
# BACKUP_ENC_ITER: iteraciones PBKDF2 (recomendado >= 100000)
BACKUP_ENC_ITER=100000
# BACKUP_ENV: development | production (afecta directorio de respaldos)
BACKUP_ENV=development
